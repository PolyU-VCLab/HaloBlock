['def max_sum(arr, n):\n    inc = [0] * n\n    dec = [0] * n\n    for i in range(n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                inc[i] = max(inc[i], inc[j] + 1)\n    for i in range(n):\n        for j in range(i):\n            if arr[i] < arr[j]:\n                dec[i] = max(dec[i], dec[j] + 1)\n    max_sum = 0\n    for i in range(n):\n        max_sum = max(max_sum, inc[i] + dec[i] + arr[i])\n    return max_sum\n']
