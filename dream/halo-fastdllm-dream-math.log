import re

def change_date_format(date):
    pattern = re.compile(r'(\d{4})-(\d{2})-(\d{2})')
    match = pattern.match(date)
    if match:
        year = match.group(1)
        month = match.group(2)
        day = match.group(3)
        return f'{day}-{month}-{year}'
    else:
        return 'Invalid date format'


