["import heapq\n\ndef find_minimum_range(arr):\n    min_heap = []\n    max_val = float('-inf')\n    min_val = float('inf')\n    for i in range(len(arr)):\n        heapq.heappush(min_heap, (arr[i][0], i, 0))\n        max_val = max(max_val, arr[i][0])\n        min_val = min(min_val, arr[i][0])\n    while True:\n        val, arr_idx, element_idx = heapq.heappop(min_heap)\n        if element_idx == len(arr[arr_idx]) - 1:\n            break\n        max_val = max(max_val, arr[arr_idx][element_idx + 1])\n        min_val = min(min_val, arr[arr_idx][element_idx + 1])\n        heapq.heappush(min_heap, (arr[arr_idx][element_idx + 1], arr_idx, element_idx + 1))\n    return (min_val, max_val)\n"]
['def zigzag(n, k):\n    if n == 0 or k == 0:\n        return 1\n    elif k == 1:\n        return n\n    elif k == n:\n        return 1\n    else:\n        return zigzag(n - 1, k - 1) + zigzag(n - 1, k) + zigzag(n - 1, k + 1)\n']
