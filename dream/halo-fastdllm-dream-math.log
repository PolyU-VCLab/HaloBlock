Response:
def rearrange_string(s):
    from collections import Counter
    char_count = Counter(s)
    max_count = max(char_count.values())
    if max_count > (len(s) + 1) // 2:
        return ""
    result = []
    for char, count in char_count.items():
        for _ in range(count):
            result.append(char)
    return "".join(result)


