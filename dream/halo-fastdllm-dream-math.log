def comb_sort(arr):
    n = len(arr)
    gap = n // 2
    while gap > 1:
        for i in range(gap, n):
            j = i
            while j >= gap and arr[j] < arr[j - gap]:
                arr[j], arr[j - gap] = arr[j - gap], arr[j]
                j -= gap
        gap = int(gap / 1.3)
    return arr


