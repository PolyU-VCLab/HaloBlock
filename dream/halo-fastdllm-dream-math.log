['def count_no_of_ways(n, k):\n    if n == 0:\n        return 0\n    if n == 1:\n        return k\n    if n == 2:\n        return k * k\n    same_color = k\n    diff_color = k * (k - 1)\n    for i in range(3, n + 1):\n        temp = same_color\n        same_color = diff_color\n        diff_color = (k - 1) * (temp + diff_color)\n    return same_color_color + diff_color\n']
