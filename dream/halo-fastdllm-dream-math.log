def get_maxgold(grid, rows, cols):
    dp = [[0] * cols for _ in range(rows)]
    for i in range(rows):
        dp[i][0] = grid[i][0]
    for j in range(1, cols):
        dp[0][j] = grid[0][j]
    for i in range(1, rows):
        for j in range(1, cols):
            dp[i][j] = grid[i][j] + max(dp[i-1][j], dp[i][j-1])
    return dp[rows-1][cols-1]


