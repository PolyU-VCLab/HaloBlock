['def ncr_modp(n, r, p):\n    result = 1\n    for i in range(r):\n        result = result * (n - i) % p\n        result = result * inverse(i + 1, p) % p\n    return result\n\ndef inverse(a, p):\n    x, y = 1, 0\n    while a > 1:\n        q = a // p\n        a, p = p, a % p\n        x, y = y, x - q * y\n    return x % p\n']
